<!doctype html>
<html lang="en" style="max-width: 1700px; margin: 0 auto;">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Home | TaskSync</title>
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
  <link rel="stylesheet" href="/../css/home.css">
  <script src="/js/statsGraphs.js" defer></script>
  <link href="/../css/custom.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
</head>

<body class="">

  <header>
    <nav class="navbar navbar-expand-lg bg-body-tertiary pt-0 pr-2 mt-0">
      <div class="container-fluid pt-2">
        <!-- TaskSync logo -->
        <a class="navbar-brand" href="#">
          <img src="/images/TaskSyncLogo.png" alt="TaskSync brand logo" height="30px">
        </a>

        <!-- Mobile View Toggler-->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <!-- Left-item -->
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="#">mySync</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/new">New Task</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/statistics">Statistics</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/personalise">Personalise</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">About</a>
            </li>
          </ul>

          <!-- Right-items -->
          <div class="dropdown ms-auto">
            <button class="btn btn-primary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
              Profile
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
              <li><a class="dropdown-item" href="#">Details</a></li>
              <li><a class="dropdown-item" href="/auth/logout">Log Out</a></li>
            </ul>
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main class="me-3 ms-3">
    <div class="row row-cols-2">
      <!--ASIDE STATISTICS - LEFT 2-COLS -->
      <div class="col-2 d-none d-xl-block " >
        <!--STATS - 1st ROW -->
        <div class="row pt-5">
          <table class=" table table-hover table-striped">
            <tbody>
              <tr>
                <th>Open Tasks</th>
                <td><%=taskOpenCompleteSummary.open%></td>
              </tr>
              <tr>
                <th>Completed Tasks</th>
                <td><%=taskOpenCompleteSummary.complete%></td>
              </tr>
              <tr>
                <th>Average time-to-completion</th>
                <td><%=taskOpenCompleteSummary.averageDays%>&nbspDays</td>
              </tr>
            </tbody>
          </table>
        </div>
        <!--STATS - 2nd ROW -->
        <div class="row">
          <table class=" table table-hover table-striped">
            <tbody>
              <tr>
                <th><img src="<%=getStarUrl(2)%>" alt="star-1">&nbsp;Urgent Priority</th>
                <td><%=taskUrgencySummary.urgentPriority%></td>
              </tr>
              <tr>
                <th><img src="<%=getStarUrl(1)%>" alt="star-1">&nbsp;Priority</th>
                <td><%=taskUrgencySummary.priority%></td>
              </tr>
              <tr>
                <th><img src="<%=getStarUrl(0)%>" alt="star-1">&nbsp;Non-urgent</th>
                <td><%=taskUrgencySummary.nonPriority%></td>
              </tr>
            </tbody>
          </table>
        </div>
        <!--STATS - 3rd ROW -->
        <div class="row p-0">
            <canvas class="m-0 p-0" id="dueSummaryChart" width="50" height="50"></canvas>
            <script>
              const tasksDueSummary = <%- tasksDueSummary %>
              document.addEventListener("DOMContentLoaded", function() {
                if (tasksDueSummary.labels && tasksDueSummary.labels.length > 0) {
                  createDueSummaryGraph(tasksDueSummary);
                } else {
                  console.warn("No data available for chart.");
                }
              });
            </script>

        </div>
      </div>
      <!--MAIN CONTENT RIGHT 10-COLS-->
      <div class="col-12 col-xl-10 ps-4">
        <!--FILTER / SORT  NAV-BAR-->
        <div class="row border-bottom pt-1 pb-1">
          <form class="d-flex flex-wrap align-items-center" action="/applyfilters" method="POST">
            <!--CATEGORIES CHECK BOXES-->
            <div class="col-sm-12 col-md-12 col-lg-6 d-flex flex-wrap me-2 ">
              <% user_categories.forEach((cat) =>{ %>
              <!-- Checkbox Option - Checked_categories passed in from req.body to place check boxes. In a GET request, checked_cateogries [] will be empty and all checkboxes will be checked. -->
              <% let checkedOption = 'checked'; %>
              <!-- First if statement ensures getCheckboxState will only execute in POST request where wanted categories are defined in selected_categories-->
              <% if (selected_categories && selected_categories.length !== 0) { checkedOption = getCheckboxState(selected_categories, cat.category_name)} %>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" <%=checkedOption%> id="<%=cat.category_name%>" value="<%=cat.category_name%>" name="selected_category">
                <label class="form-check-label" for="<%=cat.category_name%>"><%=cat.category_name%></label>
              </div>
              <% }); %>
            </div>
            <!-- Sort By Dropdown -->
            <div class="col-md-3 col-lg-2 me-4">
              <select class="form-select form-select-sm" name="sort_by" aria-label="Default select example">
                <option selected disabled>Sort by</option>
                <option value="1">Priority</option>
                <option value="2">Due date - ascending</option>
                <option value="3">Due date - descending</option>
                <option value="4">Creation date - ascending</option>
                <option value="5">Creation date - descending</option>
              </select>
            </div>
            <div class="col-md-3 col-lg-2 me-1">
              <div class="form-check form-switch">
                <!-- Show Completed toggle switch state - reads switch state from POST req if available, and sets state accordingly-->
                <% let completed_switch = '' %>
                <% if(show_completed === 'on') {completed_switch  = 'checked'} %>
                <input class="form-check-input" type="checkbox" role="switch" <%=completed_switch%> name="show_completed">
                <label class="form-check-label" for="flexSwitchCheckChecked">Show completed</label>
              </div>
            </div>
            <!--SUBMIT button-->
            <div class="col-md-3 col-lg-1 text-center">
              <button type="submit" class="btn btn-info btn-sm">Update</button>
            </div>
          </form>
        </div>
        <!--CARD CONTETNT variables. -->
        <div class="row mt-1">
          <%elements.forEach((element)=> { %>
          <% //console.log(element); %>
          <% if (element.task_status_id == '1' && show_completed === 'off') { return} %>
          <!--CARD TEMPLATE. Earch loop will generate a new card with task specific data-->
          <div class="col p-0 me-2 mb-2">
            <div class="<%=getCardStyle(element.due_date, element.task_status_id)%>" style="max-width: 20rem; min-width: 15rem;">
              <div class="card-header">Due&nbsp;&nbsp;<%=formatDisplayDate(element.due_date)%>
                <span style="float: right;"><img src="<%=getStarUrl(element.star_level)%>" alt="task priority img"></span>
              </div>
              <div class="card-body p-0 m-0">
                <em>&nbsp;Category:&nbsp;</em><img src="<%=element.colour_url%>" alt="category_colour"><%=element.category_name%>
              </div>
              <div class="card-body p-1">
                <a href="#" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-taskID="<%=element.task_id%>" data-task_name="<%=element.task_name%>" data-task_desc="<%=element.task_desc%>" data-dueDate="<%=element.due_date%>" data-cat="<%=element.task_category_id%>" data-task_status_id="<%=element.task_status_id%>" data-star="<%=element.star_level%>" style="text-decoration: none; color: rgb(30, 30, 30);">
                  <h5 class="card-title"><%=limitTextLength(element.task_name, 30)%></h5>
                  <p class="card-text"><%=limitTextLength(element.task_desc, 250)%></p>
                </a>
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>

    <!--MODAL -->
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content p-3">
          <h4>Edit Task</h4>
          <form action="/update" method="POST">
            <input type="text" id="modalTaskID" name="task_id" hidden>

            <div class="form-floating mb-3">
              <input type="text" class="form-control" placeholder="Title" id="modalTitle" name="task_name">
              <label for="floatingInput">Title</label>
            </div>
            <div class="form-floating mb-3">
              <textarea class="form-control" placeholder="Details" style="height: 300px" id="modalDesc" name="task_desc"></textarea>
              <label for="floatingTextarea2">Details</label>
            </div>

            <div class="form-floating mb-3">
              <input type="date" class="form-control" placeholder="Due Date" id="modalDate" name="task_duedate">
              <label for="floatingInput">Due Date</label>
            </div>
            <h7>Category</h7>
            <select class="form-select mb-3" aria-label="Default select example" id="modalCat" name="task_cat">
              <%let elementIndex = 1%>
              <% user_categories.forEach ((element) =>{  %>
              <option value="<%=element.task_category_id%>"><%=element.category_name%></option>
              <% }); %>
            </select>

            <h7>Priority Level</h7><br>
            <div class="btn-group mb-3" role="group" aria-label="Basic radio toggle button group">
              <input type="radio" class="btn-check" name="task_star" value="0" id="btnradio0" autocomplete="off">
              <label class="btn btn-outline-primary ps-4 pe-4" for="btnradio0"><img src="<%=getStarUrl(0)%>" alt="not_starred"></label>

              <input type="radio" class="btn-check" name="task_star" value="1" id="btnradio1" autocomplete="off">
              <label class="btn btn-outline-primary ps-4 pe-4" for="btnradio1"><img src="<%=getStarUrl(1)%>" alt="star-half"></label>

              <input type="radio" class="btn-check" name="task_star" value="2" id="btnradio2" autocomplete="off">
              <label class="btn btn-outline-primary ps-4 pe-4" for="btnradio2"><img src="<%=getStarUrl(2)%>" alt="star-fill"></label>
            </div>
            <div class="modal-footer">
              <a href="" class="btn btn-danger" id="delete_button">Delete</a>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" id="update_button" class="btn btn-primary">Update</button>
              <a href="" class="btn btn-success" id="complete_button">Complete</a>
            </div>

          </form>

        </div>
      </div>
    </div>


  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous">
  </script>
  <script src="/../js/home.js"></script>
</body>

</html>